# Configuration example: Copy to .env.development for development; refer to .env.production for deployment.
# NUXT_PUBLIC_* are public configurations; do not enter private keys or server-side secrets.
NODE_ENV=development
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000
# Obtain from the Reown Dashboard; configure the allowlist for your actual site domain(s) within the Dashboard.
NUXT_PUBLIC_REOWN_PROJECT_ID=

# Runtime settings: edit and restart the SSR server; no rebuild is needed.
NUXT_PUBLIC_DEFAULT_CHAIN_ID=137
NUXT_PUBLIC_GITHUB_URL=https://github.com/yeyu2277/pact-lock
NUXT_PUBLIC_TELEGRAM_URL=
NUXT_PUBLIC_X_URL=
# Replaces the COMPLETE network list. Keep valid JSON inside single quotes.
# tokens: [{"address":"0x...","name":"Token name","symbol":"TOKEN","decimals":18,"icon":"/icons/tokens/token.svg"}]
# icon is a local public/ path. A new icon file must also be uploaded to .output/public/.
NUXT_PUBLIC_NETWORKS_JSON='{
  "POLYGON": {
    "chainId": 137,
    "feeMode": "minimum",
